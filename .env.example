# Salin file ini menjadi `.env` lalu isi nilainya:  cp .env.example .env
# Jangan commit `.env`. Variabel berawalan PUBLIC_ akan terlihat di browser,
# jadi JANGAN isi secret apa pun (terutama service role key) di sini.

# --- Supabase (hanya untuk Auth/Google login) -------------------------------
# Buka https://supabase.com/dashboard -> pilih project -> Project Settings (ikon gear)

# Project URL, bentuknya https://<project-ref>.supabase.co
# Lokasi: Project Settings -> Data API -> "Project URL"
PUBLIC_SUPABASE_URL=

# Anon key (public, aman di browser; keamanan data dijaga oleh RLS).
# Lokasi: Project Settings -> API Keys -> tab "Legacy API Keys" -> "anon" "public"
#   (jika memakai key baru, gunakan "Publishable key" di tab "Publishable and secret API keys")
PUBLIC_SUPABASE_ANON_KEY=

# --- Backend ----------------------------------------------------------------
# Base URL API Elysia. Di production Nginx meneruskan /api/* ke backend, jadi cukup "/api".
# Di development, frontend (Astro) dan backend (port 3001) beda port; proxy dev akan diatur di modul berikutnya.
PUBLIC_API_URL=/api
