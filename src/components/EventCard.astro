---
// Template untuk rendering client-side event card
---

<template id="event-card-template">
  <article class="card event-card">
    <div class="event-card-header">
      <div class="event-card-title-row">
        <h3 class="event-name"></h3>
        <span class="badge event-status"></span>
      </div>
      <p class="event-date muted"></p>
    </div>

    <div class="event-card-stats">
      <div class="stat-col">
        <span class="stat-label muted">Anggaran</span>
        <strong class="stat-val event-budget"></strong>
      </div>
      <div class="stat-col">
        <span class="stat-label muted">Pengeluaran</span>
        <strong class="stat-val event-expenses"></strong>
      </div>
      <div class="stat-col">
        <span class="stat-label muted">Sisa</span>
        <strong class="stat-val event-remaining"></strong>
      </div>
    </div>

    <div class="event-card-meta muted">
      <span class="event-participants-count"></span>
    </div>

    <div class="event-card-actions">
      <a href="#" class="btn btn-primary btn-sm action-open">Buka event</a>
      <button type="button" class="btn btn-outline btn-sm action-edit">Ubah</button>
      <button type="button" class="btn btn-danger btn-sm action-delete">Hapus</button>
    </div>
  </article>
</template>

<style>
  .event-card { display: flex; flex-direction: column; gap: 20px; min-width: 0; }
  .event-card-header { display: flex; flex-direction: column; gap: 6px; }
  .event-card-title-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
  .event-name { font-size: 16px; font-weight: 600; overflow-wrap: anywhere; }
  .event-status { flex-shrink: 0; }
  .event-date { margin: 0; font-size: 13px; }
  .event-card-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; padding: 16px 0; border-block: 1px solid var(--border-subtle); }
  .stat-col { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .stat-label { font-size: 12px; font-weight: 600; }
  .stat-val { font-size: 14px; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
  .stat-val.negative { color: var(--status-error-text); }
  .event-card-meta { font-size: 12px; }
  .event-card-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-top: auto; }
  .action-open { margin-right: auto; }
  @media (max-width: 420px) {
    .event-card-title-row { flex-direction: column; gap: 8px; }
    .event-card-stats { grid-template-columns: minmax(0, 1fr); gap: 10px; }
    .stat-col { flex-direction: row; justify-content: space-between; gap: 16px; }
    .stat-val { text-align: right; }
  }
</style>
