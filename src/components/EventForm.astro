---
import AppearanceControl from "./AppearanceControl.astro";
// Komponen Form Modal untuk Tambah dan Edit Event
---

<dialog id="event-form-dialog" class="modal-dialog" aria-labelledby="event-form-title">
  <div class="card event-form-card">
    <div class="modal-header">
      <h3 id="event-form-title">Buat Event Baru</h3>
      <button type="button" id="btn-close-modal" class="btn btn-ghost btn-sm close-btn" aria-label="Tutup"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button>
    </div>

    <AppearanceControl />
    <form id="event-form" class="modal-form" novalidate>
      <input type="hidden" id="event-form-id" value="" />

      <div class="form-group">
        <label for="event-input-name" class="form-label">Nama Event *</label>
        <input
          type="text"
          id="event-input-name"
          autofocus
          class="form-control"
          placeholder="Contoh: Camping Bintan"
          required
          maxlength="200"
        />
      </div>

      <div class="form-row-2">
        <div class="form-group">
          <label for="event-input-date" class="form-label">Tanggal Event *</label>
          <input
            type="date"
            id="event-input-date"
            class="form-control"
            required
          />
        </div>

        <div class="form-group">
          <label for="event-input-status" class="form-label">Status *</label>
          <select id="event-input-status" class="form-control">
            <option value="upcoming">Akan datang</option>
            <option value="active">Berlangsung</option>
          </select>
        </div>
      </div>

      <fieldset class="currency-fields">
        <legend>Mata uang event</legend>
        <div class="form-group">
          <label for="event-currency-mode" class="form-label">Domestic / International</label>
          <select id="event-currency-mode" class="form-control"><option value="domestic">Domestic · Indonesia (IDR)</option><option value="international">International</option></select>
        </div>
        <div id="event-currency-picker" hidden>
          <label for="event-currency-search" class="form-label">Cari mata uang</label>
          <input id="event-currency-search" class="form-control" type="search" placeholder="Kode atau nama mata uang" autocomplete="off" aria-controls="event-base-currency" />
          <label for="event-base-currency" class="form-label">Mata uang utama</label>
          <select id="event-base-currency" class="form-control" aria-describedby="event-currency-state"></select>
        </div>
        <p id="event-currency-state" class="form-hint" role="status">Domestic tetap menggunakan IDR.</p>
        <button type="button" id="event-currency-retry" class="btn btn-ghost btn-sm" hidden>Muat ulang mata uang</button>
        <label id="currency-change-confirm" class="form-hint" hidden><input id="currency-change-ack" type="checkbox" /> <span id="currency-change-notice"></span></label>
      </fieldset>

      <div class="form-group">
        <label for="event-input-budget" class="form-label">Total anggaran (Rp) *</label>
        <div class="money-input">
          <span class="money-prefix" aria-hidden="true">Rp</span>
          <input
            type="text"
            id="event-input-budget"
            class="form-control money-control"
            placeholder="2.000.000"
            required
            inputmode="numeric"
            pattern="[0-9.,]+"
            maxlength="64"
            autocomplete="off"
            aria-describedby="budget-hint"
          />
        </div>
        <span id="budget-hint" class="form-hint">Nominal rupiah penuh, contoh 2.000.000.</span>
      </div>

      <div class="form-group">
        <label for="event-input-participants" class="form-label">Daftar Peserta *</label>
        <textarea
          id="event-input-participants"
          class="form-control"
          rows="3"
          placeholder="Contoh: Arifian, Budi, Raka"
          aria-describedby="participants-hint"
          required
        ></textarea>
        <span id="participants-hint" class="form-hint">Pisahkan tiap nama dengan koma atau baris baru. Minimal 1 peserta.</span>
      </div>

      <div class="form-group">
        <label for="event-input-notes" class="form-label">Catatan (Opsional)</label>
        <textarea
          id="event-input-notes"
          class="form-control"
          rows="2"
          placeholder="Catatan tambahan rundown, lokasi, dll."
          maxlength="2000"
        ></textarea>
      </div>

      <!-- Pesan Feedback Error -->
      <div id="event-form-error" class="error-box" role="alert" hidden></div>

      <!-- Action Buttons -->
      <div class="modal-actions">
        <button type="submit" id="btn-submit-event" class="btn btn-primary">Simpan Event</button>
      </div>
    </form>
  </div>
</dialog>

<script>
  import { fetchFx } from "../lib/fx-api";
  import { fetchWithAuth } from "../lib/api";
  import type { EventItem, EventDetail } from "../types";
  import { formatLocalDateInput } from "../lib/date";
  import { formatMoneyValue, formatMoneyInputState, parseMoneyInput } from "../lib/money-input";

  import { compareMoney, minorDigits } from "../lib/money";
  import { currencyChangeNotice,  normalizeCurrencies, type CurrencyInfo } from "../lib/fx";
  import { canCloseEventModal } from "../lib/event-modal";

  const dialog = document.getElementById("event-form-dialog") as HTMLDialogElement;
  const form = document.getElementById("event-form") as HTMLFormElement;
  const titleEl = document.getElementById("event-form-title") as HTMLElement;
  const idInput = document.getElementById("event-form-id") as HTMLInputElement;
  const nameInput = document.getElementById("event-input-name") as HTMLInputElement;
  const dateInput = document.getElementById("event-input-date") as HTMLInputElement;
  const statusInput = document.getElementById("event-input-status") as HTMLSelectElement;
  const budgetInput = document.getElementById("event-input-budget") as HTMLInputElement;
  const participantsInput = document.getElementById("event-input-participants") as HTMLTextAreaElement;
  const notesInput = document.getElementById("event-input-notes") as HTMLTextAreaElement;
  const errorBox = document.getElementById("event-form-error") as HTMLDivElement;
  const submitBtn = document.getElementById("btn-submit-event") as HTMLButtonElement;

  const modeInput = document.getElementById('event-currency-mode') as HTMLSelectElement;
  const currencyInput = document.getElementById('event-base-currency') as HTMLSelectElement;
  const currencySearch = document.getElementById('event-currency-search') as HTMLInputElement;
  const currencyState = document.getElementById('event-currency-state')!;
  const retryCurrencies = document.getElementById('event-currency-retry')!;
  const acknowledgment = document.getElementById('currency-change-ack') as HTMLInputElement;
  let currencies: CurrencyInfo[] = [];
  let editing: EventDetail['event'] | null = null;
  let locked = false;
  let selectedCurrency = 'IDR';
  let openGeneration = 0;
  const currency = () => modeInput.value === 'domestic' ? 'IDR' : selectedCurrency;
  const updateCurrency = () => {
    document.getElementById('event-currency-picker')!.hidden = modeInput.value !== 'international';
    modeInput.disabled = locked;
    currencySearch.disabled = locked || !currencies.length;
    currencyInput.disabled = locked || !currencies.length;
    currencyState.textContent = locked ? 'Mata uang terkunci setelah transaksi pertama, termasuk jika transaksi dihapus.'
      : !currencies.length ? 'Daftar mata uang belum tersedia. Domestic IDR tetap dapat digunakan; mata uang event lama tetap dipertahankan.'
      : 'Mata uang dapat diubah sebelum transaksi pertama.';
    const code = currency();
    const digits = minorDigits(code || 'IDR');
    const label = document.querySelector('label[for="event-input-budget"]');
    if (label) label.textContent = `Total anggaran (${code}) *`;
    document.querySelector('#event-form .money-prefix')!.textContent = code === 'IDR' ? 'Rp' : code;
    budgetInput.disabled = !!editing || (modeInput.value === 'international' && !currencies.some(item => item.code === code));
    budgetInput.inputMode = digits ? 'decimal' : 'numeric';
    budgetInput.placeholder = digits ? '1.000,' + '0'.repeat(digits) : '2.000.000';
    const hint = document.getElementById('budget-hint');
    if (hint) hint.textContent = editing ? 'Untuk menjaga riwayat, ubah anggaran lewat panel Penyesuaian Anggaran di halaman event.' : `${code} · ${digits} digit pecahan. Gunakan koma untuk desimal.`;
    const changed = editing && (code !== (editing.baseCurrency ?? 'IDR') || modeInput.value !== (editing.currencyMode ?? 'domestic'));
    document.getElementById('currency-change-confirm')!.hidden = !changed;
    if (changed && editing) {
      try { document.getElementById('currency-change-notice')!.textContent = currencyChangeNotice(editing, code); }
      catch { document.getElementById('currency-change-notice')!.textContent = 'Anggaran/alokasi lama tidak dapat dinyatakan dalam pecahan mata uang ini. Pilih mata uang lain.'; }
    }
  };
  const populateCurrencies = () => {
    currencyInput.replaceChildren();
    const query = currencySearch.value.trim().toLocaleLowerCase();
    const filtered = currencies.filter(item => `${item.code} ${item.name}`.toLocaleLowerCase().includes(query) || item.code === selectedCurrency);
    for (const item of filtered) currencyInput.add(new Option(`${item.code} · ${item.name}`, item.code));
    if (!currencies.some(item => item.code === selectedCurrency) && editing) currencyInput.add(new Option(`${selectedCurrency} · mata uang tersimpan`, selectedCurrency));
    currencyInput.value = selectedCurrency;
  };
  const loadCurrencies = async () => {
    retryCurrencies.hidden = true;
    try { currencies = normalizeCurrencies(await fetchFx('currencies')); }
    catch { currencies = []; retryCurrencies.hidden = false; }
    populateCurrencies(); updateCurrency();
  };
  currencySearch.addEventListener('input', populateCurrencies);
  retryCurrencies.addEventListener('click', () => { void loadCurrencies(); });
  currencyInput.addEventListener('change', () => {
    selectedCurrency = currencyInput.value;
    acknowledgment.checked = false;
    // A newly entered budget must be entered again after a currency switch.
    if (!editing) budgetInput.value = '';
    updateCurrency();
  });
  modeInput.addEventListener('change', () => {
    acknowledgment.checked = false;
    if (!editing) budgetInput.value = '';
    if (modeInput.value === 'international' && !currencies.some(item => item.code === selectedCurrency)) selectedCurrency = currencies[0]?.code ?? '';
    populateCurrencies(); updateCurrency();
  });

  const formatMoneyField = (input: HTMLInputElement, inputType?: string) => {
    const { value, caret } = formatMoneyInputState(
      input.value,
      input.selectionStart ?? input.value.length, currency(), inputType,
    );
    input.value = value;
    input.setSelectionRange(caret, caret);
  };

  budgetInput.addEventListener("input", (event) => formatMoneyField(budgetInput, (event as InputEvent).inputType));

  const showError = (msg: string) => {
    errorBox.textContent = msg;
    errorBox.hidden = false;
  };

  const hideError = () => {
    errorBox.textContent = "";
    errorBox.hidden = true;
  };

  const resetForm = () => {
    form.reset();
    openGeneration++;
    idInput.value = "";
    hideError();
  };

  const closeModal = (trigger: "close-button" | "form-submit") => {
    if (trigger === "close-button" && canCloseEventModal(trigger)) {
      dialog.close();
      resetForm();
    } else if (trigger === "form-submit") {
      dialog.close();
      resetForm();
    }
  };

  document.getElementById("btn-close-modal")?.addEventListener("click", () => closeModal("close-button"));
  dialog.addEventListener("cancel", (event) => event.preventDefault());


  // Handler Event Buka Form (Mode Create atau Edit)
  window.addEventListener("open-event-form", async (e: Event) => {
    const custom = e as CustomEvent<{ mode: "create" | "edit"; event?: EventItem }>;
    const detail = custom.detail;
    hideError();
    form.reset();
    const generation = ++openGeneration;
    editing = null;
    locked = false;
    selectedCurrency = detail.event?.baseCurrency ?? 'IDR';
    modeInput.value = detail.event?.currencyMode ?? 'domestic';
    currencySearch.value = '';
    submitBtn.disabled = false;
    populateCurrencies(); updateCurrency();
    void loadCurrencies();

    if (detail.mode === "create") {
      titleEl.textContent = "Buat Event Baru";
      idInput.value = "";
      // Set default tanggal hari ini
      dateInput.value = formatLocalDateInput(new Date());
      statusInput.value = "upcoming";
      budgetInput.disabled = false;
      const budgetHint = document.getElementById("budget-hint");
      if (budgetHint) budgetHint.textContent = "Nominal rupiah penuh, contoh 2.000.000.";
      submitBtn.textContent = "Buat Event";
      dialog.showModal();
    } else if (detail.mode === "edit" && detail.event) {
      const ev = detail.event;
      titleEl.textContent = "Ubah event";
      idInput.value = ev.id;
      nameInput.value = ev.name;
      dateInput.value = ev.eventDate;
      statusInput.value = ev.status;
      editing = ev;
      locked = true; // A fresh owner read decides whether edits are allowed.
      updateCurrency();
      budgetInput.value = formatMoneyValue(ev.budget, ev.baseCurrency ?? 'IDR');
      budgetInput.disabled = true;
      const budgetHint = document.getElementById("budget-hint");
      if (budgetHint) budgetHint.textContent = "Untuk menjaga riwayat, ubah anggaran lewat panel Penyesuaian Anggaran di halaman event.";
      notesInput.value = ev.notes || "";
      submitBtn.textContent = "Simpan Perubahan";
      participantsInput.value = "";
      submitBtn.disabled = true;
      dialog.showModal();

      // Fetch detail event untuk mendapatkan daftar nama peserta
      try {
        const res = await fetchWithAuth(`/events/${ev.id}`);
        if (res.ok) {
          const data: EventDetail = await res.json();
          if (generation !== openGeneration || !dialog.open) return;
          editing = data.event;
          locked = !!data.event.currencyLocked || data.transactions.length > 0 || data.event.status === 'completed';
          selectedCurrency = data.event.baseCurrency ?? 'IDR';
          modeInput.value = data.event.currencyMode ?? 'domestic';
          budgetInput.value = formatMoneyValue(data.event.budget, selectedCurrency);
          populateCurrencies(); updateCurrency();
          submitBtn.disabled = data.event.status === 'completed';
          const names = data.participants.map((p) => p.name).join("\n");
          participantsInput.value = names;
        } else { throw Error('Gagal memuat event terbaru. Tutup dan coba lagi.'); }
      } catch {
        if (generation === openGeneration && dialog.open) showError('Gagal memuat event terbaru. Tutup dan coba lagi.');
      }
    }
  });

  // Submit Handler dengan validasi client-side
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    hideError();

    const name = nameInput.value.trim();
    const eventDate = dateInput.value;
    const budget = parseMoneyInput(budgetInput.value, currency());
    const status = statusInput.value as "upcoming" | "active";
    const notes = notesInput.value.trim() || null;
    const isEdit = !!idInput.value;

    // Parsing peserta
    const rawParticipants = participantsInput.value
      .split(/[\n,]+/)
      .map((p) => p.trim())
      .filter((p) => p.length > 0);

    // Client Validation
    if (!name) {
      showError("Nama event tidak boleh kosong.");
      nameInput.focus();
      return;
    }

    if (!eventDate) {
      showError("Tanggal event harus diisi.");
      dateInput.focus();
      return;
    }

    if (!isEdit && (budget === null || compareMoney(budget, "0", currency()) <= 0)) {
      showError("Anggaran harus sesuai pecahan mata uang dan lebih dari 0.");
      budgetInput.focus();
      return;
    }

    if (rawParticipants.length === 0) {
      showError("Peserta event minimal 1 orang.");
      participantsInput.focus();
      return;
    }

    const changed = editing && (currency() !== (editing.baseCurrency ?? 'IDR') || modeInput.value !== (editing.currencyMode ?? 'domestic'));
    if (modeInput.value === 'international' && (!editing || changed) && !currencies.some(item => item.code === currency())) {
      showError('Pilih mata uang dari daftar API yang tersedia.'); return;
    }
    if (changed && editing) {
      try { currencyChangeNotice(editing, currency()); }
      catch { showError('Anggaran/alokasi lama tidak sesuai pecahan mata uang baru.'); return; }
      if (locked || !acknowledgment.checked) { showError('Setujui perubahan nominal anggaran dan alokasi terlebih dahulu.'); return; }
    }
    form.setAttribute("aria-busy", "true");
    submitBtn.disabled = true;
    submitBtn.textContent = isEdit ? "Menyimpan…" : "Membuat…";

    try {
      const payload = {
        name,
        eventDate,
        budget: isEdit ? undefined : budget,
        ...(!isEdit || changed ? { currencyMode: modeInput.value, baseCurrency: currency() } : {}),
        status,
        notes,
        participants: rawParticipants,
      };

      const url = isEdit ? `/events/${idInput.value}` : "/events";
      const method = isEdit ? "PATCH" : "POST";

      const res = await fetchWithAuth(url, {
        method,
        body: JSON.stringify(payload),
      });

      if (!res.ok) {
        const errData = await res.json().catch(() => ({}));
        if (res.status === 409) {
          // Keep entered data and display the conflict. Reopening reads fresh owner state.
          locked = true; updateCurrency();
        }
        throw new Error(errData.error || `Gagal menyimpan event (status ${res.status})`);
      }

      // Berhasil
      closeModal("form-submit");
      // Memicu refresh daftar event di index.astro
      window.dispatchEvent(new CustomEvent("refresh-events"));
      window.dispatchEvent(new CustomEvent("refresh-event-detail"));
    } catch (err: any) {
      showError(err.message || "Terjadi kesalahan saat menyimpan event.");
    } finally {
      form.removeAttribute("aria-busy");
      submitBtn.disabled = false;
      submitBtn.textContent = isEdit ? "Simpan Perubahan" : "Buat Event";
    }
  });
</script>

