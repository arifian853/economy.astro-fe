<button type="button" id="google-login" class="btn btn-outline google-button">
  <svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M21.6 12.23c0-.71-.06-1.39-.18-2.05H12v3.88h5.38a4.6 4.6 0 0 1-2 3.01v2.5h3.24c1.9-1.75 2.98-4.33 2.98-7.34Z"/><path d="M12 22c2.7 0 4.96-.9 6.62-2.43l-3.24-2.5c-.9.6-2.05.96-3.38.96-2.6 0-4.8-1.76-5.58-4.13H3.08v2.58A10 10 0 0 0 12 22Z"/><path d="M6.42 13.9A6 6 0 0 1 6.1 12c0-.66.11-1.3.32-1.9V7.52H3.08A10 10 0 0 0 2 12c0 1.61.38 3.13 1.08 4.48l3.34-2.58Z"/><path d="M12 5.97c1.47 0 2.79.5 3.82 1.49l2.86-2.86A9.6 9.6 0 0 0 12 2a10 10 0 0 0-8.92 5.52l3.34 2.58C7.2 7.73 9.4 5.97 12 5.97Z"/></svg>
  <span id="google-login-label">Lanjutkan dengan Google</span>
</button>

<script>
  import { supabase } from "../lib/supabase";

  const btn = document.getElementById("google-login") as HTMLButtonElement;
  btn.addEventListener("click", async () => {
    btn.disabled = true;
    btn.setAttribute("aria-busy", "true");
    const label = document.getElementById("google-login-label");
    if (label) label.textContent = "Menghubungkan…";
    const { error } = await supabase.auth.signInWithOAuth({
      provider: "google",
      options: { redirectTo: `${location.origin}/auth/callback` },
    });
    if (error) {
      btn.disabled = false;
      btn.removeAttribute("aria-busy");
      if (label) label.textContent = "Lanjutkan dengan Google";
      btn.dispatchEvent(new CustomEvent("login-error", { detail: error.message, bubbles: true }));
    }
  });
</script>
