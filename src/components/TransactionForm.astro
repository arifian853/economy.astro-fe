---
import AppearanceControl from "./AppearanceControl.astro";
// Komponen modal dialog form transaksi (Tambah & Edit)
---

<dialog id="tx-modal" class="modal-dialog" aria-labelledby="tx-modal-title">
  <div class="card tx-form-card">
    <div class="tx-modal-header">
      <div class="tx-modal-heading">
        <span class="tx-modal-mark" aria-hidden="true">
          <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12v18l-3-2-3 2-3-2-3 2V3Z"/><path d="M9 7h6M9 11h6M9 15h3"/></svg>
        </span>
        <div class="tx-modal-title-copy">
          <p class="tx-modal-context">Catatan kas event</p>
          <h3 id="tx-modal-title">Tambah pengeluaran</h3>
          <p class="tx-modal-intro">Total dihitung otomatis.</p>
        </div>
      </div>
      <button type="button" id="btn-close-tx" class="btn btn-ghost close-btn" aria-label="Tutup formulir pengeluaran">
        <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
      </button>
    </div>

    <AppearanceControl id="transaction-form-appearance" />
    <form id="tx-form" class="modal-form tx-modal-form">
      <input type="hidden" id="tx-form-id" value="" />
      <input type="hidden" id="tx-form-event-id" value="" />

      <div class="form-group">
        <label for="tx-input-name" class="form-label">Keperluan *</label>
        <input
          type="text"
          id="tx-input-name"
          class="form-control"
          placeholder="Contoh: Air mineral, konsumsi, bensin…"
          required
          maxlength="200"
        />
      </div>

      <div class="form-row-2 tx-form-row tx-price-row">
        <div class="form-group">
          <label for="tx-input-qty" class="form-label">Jumlah barang *</label>
          <input
            type="number"
            id="tx-input-qty"
            class="form-control"
            required
            min="1"
            step="1"
            inputmode="numeric"
            value="1"
          />
        </div>
        <div class="form-group">
          <label for="tx-input-price" class="form-label">Harga satuan *</label>
          <div class="money-input tx-money-input">
            <span class="money-prefix" aria-hidden="true">Rp</span>
            <input
              type="text"
              id="tx-input-price"
              class="form-control money-control"
              placeholder="25.000"
              required
              inputmode="numeric"
              pattern="[0-9.,]+"
              maxlength="64"
              autocomplete="off"
              aria-describedby="tx-price-hint"
            />
          </div>
          <span id="tx-price-hint" class="form-hint">Rupiah penuh, contoh 25.000.</span>
        </div>
      </div>

      <div class="live-total-container tx-total-container">
        <div class="tx-total-copy">
          <span class="live-total-label">Total pengeluaran</span>
          <span id="tx-live-breakdown" class="tx-total-breakdown">1 barang × Rp0</span>
        </div>
        <strong id="tx-live-total" class="live-total-value" aria-live="polite" aria-atomic="true">Rp0</strong>
      </div>

      <p id="tx-idr-reference" class="form-hint" hidden></p>

      <div class="form-row-2 tx-form-row">
        <div class="form-group">
          <label for="tx-input-method" class="form-label">Metode pembayaran *</label>
          <select id="tx-input-method" class="form-control">
            <option value="cash">Tunai</option>
            <option value="qris" selected>QRIS</option>
            <option value="transfer">Transfer</option>
            <option value="ewallet">Dompet digital</option>
            <option value="other">Lainnya</option>
          </select>
        </div>
        <div class="form-group">
          <label for="tx-input-time" class="form-label">Waktu transaksi</label>
          <input type="datetime-local" id="tx-input-time" class="form-control" />
        </div>
      </div>

      <div class="form-group">
        <label for="tx-input-note" class="form-label">Catatan (opsional)</label>
        <textarea
          id="tx-input-note"
          class="form-control"
          rows="2"
          placeholder="Toko, bukti nota, atau info tambahan…"
          maxlength="2000"
        ></textarea>
      </div>

      <details class="tx-evidence-details">
        <summary>Bukti pengeluaran <span class="muted">(opsional)</span></summary>
        <div class="tx-evidence-fields">
          <div class="form-group">
            <label for="tx-input-evidence-file" class="form-label">Foto / file bukti</label>
            <input id="tx-input-evidence-file" class="form-control" type="file" accept="image/jpeg,image/png,image/webp,application/pdf" />
            <span class="form-hint">JPG, PNG, WebP, PDF · maks. 12 MiB. Disimpan privat.</span>
          </div>
          <div class="form-group">
            <label for="tx-input-evidence-url" class="form-label">Tautan bukti</label>
            <input id="tx-input-evidence-url" class="form-control" type="url" inputmode="url" autocomplete="url" placeholder="https://…" />
          </div>
        </div>
      </details>

      <div id="tx-form-error" class="error-box" role="alert" hidden></div>

      <div class="modal-actions tx-modal-actions">
        <button type="submit" id="btn-submit-tx" class="btn btn-primary tx-submit-btn">Simpan pengeluaran</button>
      </div>
    </form>
  </div>
</dialog>

<script>
  import { fetchWithAuth } from "../lib/api";
  import { alertDialog } from "../lib/dialog";
  import { multiplyMoney, minorDigits } from "../lib/money";
  import { formatCurrency } from "../lib/currency";
  import { formatMoneyValue, formatMoneyInputState, parseMoneyInput } from "../lib/money-input";
  import { approximateIdr, eventReference, referenceLabel, type FxReference } from "../lib/fx";
  import type { EventCurrency } from "../types";
  import type { Transaction } from "../types";

  const $ = <T extends HTMLElement = HTMLElement>(id: string): T | null =>
    document.getElementById(id) as T | null;

  const dialog = $("tx-modal") as HTMLDialogElement | null;
  const form = $("tx-form") as HTMLFormElement | null;
  const titleEl = $("tx-modal-title");
  const idInput = $("tx-form-id") as HTMLInputElement | null;
  const eventIdInput = $("tx-form-event-id") as HTMLInputElement | null;
  const nameInput = $("tx-input-name") as HTMLInputElement | null;
  const qtyInput = $("tx-input-qty") as HTMLInputElement | null;
  const priceInput = $("tx-input-price") as HTMLInputElement | null;
  const methodInput = $("tx-input-method") as HTMLSelectElement | null;
  const timeInput = $("tx-input-time") as HTMLInputElement | null;
  const noteInput = $("tx-input-note") as HTMLTextAreaElement | null;
  const evidenceFileInput = $("tx-input-evidence-file") as HTMLInputElement | null;
  const evidenceUrlInput = $("tx-input-evidence-url") as HTMLInputElement | null;
  const errorBox = $("tx-form-error");
  const submitBtn = $("btn-submit-tx") as HTMLButtonElement | null;
  const closeBtn = $("btn-close-tx") as HTMLButtonElement | null;
  const liveTotalEl = $("tx-live-total");
  const liveBreakdownEl = $("tx-live-breakdown");

  let currency = 'IDR';
  let fx: FxReference = { rate: null, date: null, provider: null };
  let snapshot = false;
  // Helper untuk format local datetime input YYYY-MM-DDTHH:mm
  const toLocalDatetimeString = (date: Date): string => {
    const pad = (n: number) => String(n).padStart(2, "0");
    const y = date.getFullYear();
    const m = pad(date.getMonth() + 1);
    const d = pad(date.getDate());
    const hh = pad(date.getHours());
    const mm = pad(date.getMinutes());
    return `${y}-${m}-${d}T${hh}:${mm}`;
  };

  const updateLiveTotal = () => {
    const quantity = Number(qtyInput?.value || 0);
    const unitPrice = parseMoneyInput(priceInput?.value || "0", currency);
    let total = '0';
    try { if (unitPrice === null) throw Error('Invalid price'); total = multiplyMoney(unitPrice, Math.max(0, quantity), currency); }
    catch { if (liveTotalEl) liveTotalEl.textContent = 'Periksa nominal / jumlah'; if (liveBreakdownEl) liveBreakdownEl.textContent = ''; const reference = $('tx-idr-reference'); if (reference) { reference.hidden = currency === 'IDR'; reference.textContent = 'Masukkan nominal yang valid untuk melihat referensi IDR.'; } return; }

    if (liveTotalEl) liveTotalEl.textContent = formatCurrency(total, currency);
    const reference = $('tx-idr-reference');
    if (reference) {
      reference.hidden = currency === 'IDR';
      reference.textContent = `${approximateIdr(total, currency, fx)} · ${snapshot ? 'Snapshot transaksi' : 'Perkiraan; snapshot disimpan server saat pencatatan'} · ${referenceLabel(fx)}`;
    }
    if (liveBreakdownEl) {
      liveBreakdownEl.textContent = `${quantity || 0} barang × ${formatCurrency(unitPrice ?? '0', currency)}`;
    }
  };

  const formatMoneyField = (input: HTMLInputElement, inputType?: string) => {
    const { value, caret } = formatMoneyInputState(
      input.value,
      input.selectionStart ?? input.value.length, currency, inputType,
    );
    input.value = value;
    input.setSelectionRange(caret, caret);
  };

  qtyInput?.addEventListener("input", updateLiveTotal);
  if (priceInput) {
    priceInput.addEventListener("input", (event) => {
      formatMoneyField(priceInput, (event as InputEvent).inputType);
      updateLiveTotal();
    });
  }

  // Buka Modal Tambah/Edit
  window.addEventListener("open-tx-form", (e: Event) => {
    const detail = (e as CustomEvent<{
      mode: "add" | "edit";
      eventId?: string;
      eventCurrency?: EventCurrency;
      tx?: Transaction;
    }>).detail;

    if (!dialog) return;
    currency = detail.tx?.baseCurrency ?? detail.eventCurrency?.baseCurrency ?? 'IDR';
    snapshot = detail.mode === 'edit';
    fx = snapshot ? { rate: detail.tx?.fxRateToIdr ?? null, date: detail.tx?.fxRateDate ?? null, provider: detail.tx?.fxRateProvider ?? null } : eventReference(detail.eventCurrency ?? {});
    document.querySelector('#tx-form .money-prefix')!.textContent = currency === 'IDR' ? 'Rp' : currency;
    const digits = minorDigits(currency);
    if (priceInput) { priceInput.inputMode = digits ? 'decimal' : 'numeric'; priceInput.placeholder = digits ? '25,' + '0'.repeat(digits) : '25.000'; }
    const hint = $('tx-price-hint');
    if (hint) hint.textContent = `${currency} · ${digits} digit pecahan; gunakan koma untuk desimal.`;

    if (errorBox) {
      errorBox.textContent = "";
      errorBox.hidden = true;
    }

    if (detail.mode === "add") {
      if (titleEl) titleEl.textContent = "Tambah pengeluaran";
      if (submitBtn) submitBtn.textContent = "Simpan pengeluaran";
      if (idInput) idInput.value = "";
      if (eventIdInput) eventIdInput.value = detail.eventId || "";

      if (nameInput) nameInput.value = "";
      if (qtyInput) qtyInput.value = "1";
      if (priceInput) priceInput.value = "";
      if (methodInput) methodInput.value = "qris";
      if (timeInput) timeInput.value = toLocalDatetimeString(new Date());
      if (noteInput) noteInput.value = "";
    } else if (detail.mode === "edit" && detail.tx) {
      const tx = detail.tx;
      if (titleEl) titleEl.textContent = "Ubah pengeluaran";
      if (submitBtn) submitBtn.textContent = "Simpan perubahan";
      if (idInput) idInput.value = tx.id;
      if (eventIdInput) eventIdInput.value = tx.eventId || "";

      if (nameInput) nameInput.value = tx.name;
      if (qtyInput) qtyInput.value = String(tx.quantity);
      if (priceInput) priceInput.value = formatMoneyValue(tx.unitPrice, currency);
      if (methodInput) methodInput.value = tx.paymentMethod;
      if (timeInput) {
        timeInput.value = tx.transactionAt
          ? toLocalDatetimeString(new Date(tx.transactionAt))
          : toLocalDatetimeString(new Date());
      }
      if (noteInput) noteInput.value = tx.note || "";
    }

    if (evidenceFileInput) evidenceFileInput.value = "";
    if (evidenceUrlInput) evidenceUrlInput.value = "";
    updateLiveTotal();
    dialog.showModal();
    if (window.matchMedia("(pointer: fine)").matches) {
      nameInput?.focus({ preventScroll: true });
    } else {
      closeBtn?.focus({ preventScroll: true });
    }
  });

  const closeModal = () => {
    dialog?.close();
  };

  dialog?.addEventListener("cancel", (event) => {
    event.preventDefault();
  });
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) {
      event.preventDefault();
      event.stopPropagation();
    }
  });

  closeBtn?.addEventListener("click", closeModal);

  // Submit Handler (Checkpoint M11.2, M11.3)
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    const id = idInput?.value;
    const eventId = eventIdInput?.value;
    const name = nameInput?.value.trim();
    const quantity = Number(qtyInput?.value);
    const unitPrice = parseMoneyInput(priceInput?.value || "", currency);
    const paymentMethod = methodInput?.value;
    const timeVal = timeInput?.value;
    const note = noteInput?.value.trim() || null;

    if (!name) {
      if (errorBox) {
        errorBox.textContent = "Nama keperluan tidak boleh kosong.";
        errorBox.hidden = false;
      }
      nameInput?.focus();
      return;
    }

    if (!Number.isSafeInteger(quantity) || quantity < 1) {
      if (errorBox) {
        errorBox.textContent = "Jumlah harus bilangan bulat, minimal 1.";
        errorBox.hidden = false;
      }
      qtyInput?.focus();
      return;
    }

    if (unitPrice === null) {
      if (errorBox) {
        errorBox.textContent = "Masukkan harga satuan sesuai pecahan mata uang event.";
        errorBox.hidden = false;
      }
      priceInput?.focus();
      return;
    }

    try { multiplyMoney(unitPrice, quantity, currency); }
    catch { if (errorBox) { errorBox.textContent = 'Total melebihi batas nominal yang dapat disimpan.'; errorBox.hidden = false; } return; }

    if (!id && !eventId) {
      if (errorBox) {
        errorBox.textContent = "Event ID tidak ditemukan.";
        errorBox.hidden = false;
      }
      return;
    }

    if (errorBox) errorBox.hidden = true;
    form?.setAttribute("aria-busy", "true");
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = "Menyimpan…";
    }
    if (closeBtn) closeBtn.disabled = true;

    try {
      const transactionAt = timeVal ? new Date(timeVal).toISOString() : new Date().toISOString();

      let savedTransactionId = id || "";
      if (!id) {
        // Mode Add: POST /api/events/:eventId/transactions
        const res = await fetchWithAuth(`/events/${eventId}/transactions`, {
          method: "POST",
          body: JSON.stringify({ name, quantity, unitPrice, baseCurrency: currency, paymentMethod, transactionAt, note }),
        });

        if (!res.ok) {
          const errData = await res.json().catch(() => ({}));
          throw new Error(errData.error || `Gagal menambah transaksi (${res.status})`);
        }
        const created = await res.json();
        savedTransactionId = created.id;
      } else {
        // Mode Edit: PATCH /api/transactions/:id
        const res = await fetchWithAuth(`/transactions/${id}`, {
          method: "PATCH",
          body: JSON.stringify({ name, quantity, unitPrice, baseCurrency: currency, paymentMethod, transactionAt, note }),
        });

        if (!res.ok) {
          const errData = await res.json().catch(() => ({}));
          throw new Error(errData.error || `Gagal memperbarui transaksi (${res.status})`);
        }
      }

      let evidenceError: string | null = null;
      try {
        const evidenceUrl = evidenceUrlInput?.value.trim();
        if (evidenceUrl) {
          const linkResponse = await fetchWithAuth(`/transactions/${savedTransactionId}/evidence-links`, {
            method: "POST",
            body: JSON.stringify({ url: evidenceUrl, label: "Tautan bukti" }),
          });
          if (!linkResponse.ok) {
            const error = await linkResponse.json().catch(() => ({}));
            throw new Error(error.error || `Tautan bukti gagal disimpan (${linkResponse.status})`);
          }
        }

        const evidenceFile = evidenceFileInput?.files?.[0];
        if (evidenceFile) {
          const payload = new FormData();
          payload.append("file", evidenceFile);
          const fileResponse = await fetchWithAuth(`/transactions/${savedTransactionId}/evidence-files`, {
            method: "POST",
            body: payload,
          });
          if (!fileResponse.ok) {
            const error = await fileResponse.json().catch(() => ({}));
            throw new Error(error.error || `Unggah bukti gagal (${fileResponse.status})`);
          }
        }
      } catch (evidenceFailure) {
        evidenceError = evidenceFailure instanceof Error ? evidenceFailure.message : "Bukti gagal disimpan.";
      }

      closeModal();
      window.dispatchEvent(new CustomEvent("refresh-event-detail"));
      if (evidenceError) {
        void alertDialog({ title: "Pengeluaran tersimpan", message: `Pengeluaran berhasil dicatat, tetapi bukti belum tersimpan. ${evidenceError}` });
      }
    } catch (err: unknown) {
      console.error("[Economy] Transaction mutation error:", err);
      if (errorBox) {
        errorBox.textContent = err instanceof Error ? err.message : "Terjadi kesalahan.";
        errorBox.hidden = false;
      }
    } finally {
      form?.removeAttribute("aria-busy");
      if (closeBtn) closeBtn.disabled = false;
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = id ? "Simpan perubahan" : "Simpan pengeluaran";
      }
    }
  });
</script>

