---
interface Props { id: string; label?: string }
const { id, label = 'Mata uang utama' } = Astro.props;
---
<div class="currency-combobox" data-currency-combobox data-id={id}>
  <button id={`${id}-trigger`} class="currency-trigger" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls={`${id}-panel`}>
    <span class="currency-trigger-copy"><span class="currency-trigger-label">{label}</span><strong data-currency-current>Pilih mata uang</strong></span>
    <svg class="currency-trigger-chevron" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m5 7.5 5 5 5-5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <div id={`${id}-panel`} class="currency-layer" data-currency-layer hidden>
    <button class="currency-scrim" type="button" aria-label="Tutup pilihan mata uang" data-currency-dismiss tabindex="-1"></button>
    <section class="currency-panel" role="dialog" aria-label={label}>
      <header class="currency-panel-header">
        <div><p class="currency-panel-kicker">Mata uang</p><h2>{label}</h2></div>
        <button class="currency-close" type="button" aria-label="Tutup pilihan mata uang" data-currency-dismiss>×</button>
      </header>
      <label class="sr-only" for={`${id}-currency-input`}>Cari kode atau nama mata uang</label>
      <input id={`${id}-currency-input`} class="currency-search" type="search" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls={`${id}-currency-list`} aria-label="Cari kode atau nama mata uang" placeholder="Cari kode atau nama mata uang" autocomplete="off" />
      <div id={`${id}-currency-list`} class="currency-list" role="listbox" aria-label="Mata uang tersedia"></div>
      <p class="currency-empty" data-currency-empty role="status" hidden>Tidak ada mata uang yang cocok.</p>
    </section>
  </div>
</div>
<style>
  .currency-combobox { position: relative; min-width: 0; color: var(--text-main); font: inherit; }
  .currency-trigger { display: flex; align-items: center; justify-content: space-between; gap: 16px; width: 100%; min-width: 0; min-height: 56px; padding: 9px 14px; border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); background: var(--bg-surface); color: var(--text-main); text-align: left; cursor: pointer; }
  .currency-trigger:focus-visible, .currency-close:focus-visible, .currency-scrim:focus-visible { outline: 2px solid var(--border-active); outline-offset: 2px; }
  .currency-trigger-copy { display: grid; gap: 2px; min-width: 0; }
  .currency-trigger-label { color: var(--text-muted-readable); font-size: 11px; font-weight: 500; }
  .currency-trigger strong { overflow-wrap: anywhere; font-size: 15px; font-weight: 600; }
  .currency-trigger-chevron { width: 18px; height: 18px; flex: 0 0 auto; color: var(--text-muted-readable); transition: transform var(--motion-fast, 150ms) var(--ease-out-soft, ease); }
  .currency-combobox[data-open="true"] .currency-trigger-chevron { transform: rotate(180deg); }
  .currency-layer { position: absolute; inset-block-start: calc(100% + 6px); inset-inline: 0; z-index: 100; }
  .currency-scrim { display: none; }
  .currency-panel { display: flex; flex-direction: column; gap: 12px; width: 100%; max-height: min(26rem, 65vh); padding: 16px; border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); background: var(--bg-surface); color: var(--text-main); box-shadow: var(--shadow-md); animation: currency-pop-in var(--motion-control, 190ms) var(--ease-out-soft, ease) both; }
  .currency-panel-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .currency-panel-kicker { margin: 0 0 2px; color: var(--primary); font-size: 11px; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; }
  .currency-panel-header h2 { margin: 0; font: 500 17px/1.3 var(--font-heading); }
  .currency-close { display: grid; place-items: center; width: 44px; height: 44px; flex: 0 0 44px; padding: 0; border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); background: var(--bg-surface); color: var(--text-main); font-size: 24px; cursor: pointer; }
  .currency-search { width: 100%; min-height: 48px; padding: 10px 12px; border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); background: var(--bg-surface); color: var(--text-main); font: inherit; }
  .currency-search:focus-visible { outline: 2px solid var(--border-active); outline-offset: 2px; }
  .currency-list { display: grid; gap: 3px; min-height: 44px; max-height: min(20rem, 55vh); overflow-y: auto; overscroll-behavior: contain; }
  .currency-option { display: flex; align-items: center; gap: 11px; min-width: 0; min-height: 46px; padding: 6px 11px; border: 1px solid transparent; border-radius: var(--radius-sm); color: var(--text-main); cursor: pointer; }
  .currency-option[data-active="true"], .currency-option:hover { background: var(--bg-surface-hover); }
  .currency-option[data-selected="true"] { border-color: var(--border-subtle); background: var(--bg-surface-variant); }
  .currency-option-code { flex: 0 0 42px; font: 600 12px var(--font-mono); }
  .currency-option-name { min-width: 0; flex: 1; overflow-wrap: anywhere; font-size: 14px; }
  .currency-option-check { display: grid; place-items: center; width: 20px; height: 20px; flex: 0 0 20px; color: var(--primary); opacity: 0; transform: scale(.8); transition: opacity var(--motion-fast, 150ms) ease, transform var(--motion-fast, 150ms) var(--ease-out-soft, ease); }
  .currency-option-check svg { width: 17px; height: 17px; }
  .currency-option[data-selected="true"] .currency-option-check { opacity: 1; transform: scale(1); }
  .currency-empty { margin: 0; padding: 12px 8px; color: var(--text-muted-readable); font-size: 13px; }
  @keyframes currency-pop-in { from { opacity: 0; transform: translateY(-4px) scale(.985); } to { opacity: 1; transform: translateY(0) scale(1); } }
  @media (max-width: 600px) {
    .currency-layer { position: fixed; inset: 0; z-index: 300; display: grid; align-items: end; }
    .currency-layer[hidden] { display: none; }
    .currency-scrim { position: absolute; inset: 0; display: block; width: 100%; height: 100%; border: 0; border-radius: 0; background: color-mix(in srgb, var(--text-main) 44%, transparent); }
    .currency-panel { position: relative; width: 100%; max-height: min(82dvh, 44rem); min-height: min(60dvh, 27rem); padding: 20px 16px max(16px, env(safe-area-inset-bottom)); border-radius: var(--radius-lg) var(--radius-lg) 0 0; box-shadow: var(--shadow-lg); }
    .currency-list { flex: 1; min-height: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .currency-panel, .currency-trigger-chevron, .currency-option-check { animation: none !important; transition: none !important; } }
</style>
<script>
  interface Currency { code: string; name: string; symbol: string; minorUnits: number }
  interface OptionsDetail { id: string; options: Currency[] }
  interface ValueDetail { id: string; value: string; disabled?: boolean }

  for (const root of document.querySelectorAll<HTMLElement>('[data-currency-combobox]')) {
    const id = root.dataset.id!;
    const trigger = root.querySelector<HTMLButtonElement>('.currency-trigger')!;
    const currentLabel = root.querySelector<HTMLElement>('[data-currency-current]')!;
    const layer = root.querySelector<HTMLElement>('[data-currency-layer]')!;
    const search = root.querySelector<HTMLInputElement>('.currency-search')!;
    const list = root.querySelector<HTMLElement>('.currency-list')!;
    const empty = root.querySelector<HTMLElement>('[data-currency-empty]')!;
    let options: Currency[] = [];
    let value = '';
    let active = -1;
    let opener: HTMLElement | null = null;

    const selected = () => options.find(option => option.code === value);
    const updateSelectedLabel = () => { const option = selected(); currentLabel.textContent = option ? `${option.code} · ${option.name}` : value ? `${value} · mata uang tersimpan` : 'Pilih mata uang'; };
    const close = (restoreFocus = false) => {
      layer.hidden = true;
      root.dataset.open = 'false';
      trigger.setAttribute('aria-expanded', 'false');
      search.setAttribute('aria-expanded', 'false');
      search.removeAttribute('aria-activedescendant');
      search.value = '';
      if (restoreFocus) (opener ?? trigger).focus();
    };
    const render = (query = search.value) => {
      const current = selected();
      const normalizedQuery = query.trim().toLocaleLowerCase();
      const filtered = options.filter(option => `${option.code} ${option.name}`.toLocaleLowerCase().includes(normalizedQuery));
      if (current && !filtered.some(option => option.code === current.code)) filtered.unshift(current);
      list.replaceChildren();
      active = -1;
      search.removeAttribute('aria-activedescendant');
      empty.hidden = filtered.length > 0;
      for (const [index, option] of filtered.entries()) {
        const row = document.createElement('div');
        row.id = `${id}-currency-option-${index}`;
        row.className = 'currency-option';
        row.setAttribute('role', 'option');
        row.setAttribute('aria-selected', String(option.code === value));
        row.dataset.selected = String(option.code === value);
        row.dataset.active = 'false';
        row.dataset.code = option.code;
        const code = document.createElement('span');
        code.className = 'currency-option-code';
        code.textContent = option.code;
        const name = document.createElement('span');
        name.className = 'currency-option-name';
        name.textContent = `${option.name} (${option.symbol})`;
        const check = document.createElement('span');
        check.className = 'currency-option-check';
        check.setAttribute('aria-hidden', 'true');
        check.innerHTML = '<svg viewBox="0 0 20 20" fill="none"><path d="m4 10 4 4 8-8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
        row.append(code, name, check);
        row.addEventListener('mousedown', event => event.preventDefault());
        row.addEventListener('click', () => choose(option));
        list.append(row);
      }
    };
    const open = () => {
      if (trigger.disabled) return;
      opener = trigger;
      layer.hidden = false;
      root.dataset.open = 'true';
      trigger.setAttribute('aria-expanded', 'true');
      search.setAttribute('aria-expanded', 'true');
      search.value = '';
      render('');
      search.focus();
    };
    const choose = (currency: Currency) => {
      value = currency.code;
      updateSelectedLabel();
      document.dispatchEvent(new CustomEvent('economy:currency-selected', { detail: { id, currency }, bubbles: true }));
      close(true);
    };
    const moveActive = (delta: number) => {
      const rows = [...list.querySelectorAll<HTMLElement>('[role="option"]')];
      if (!rows.length) return;
      active = active < 0 ? (delta > 0 ? 0 : rows.length - 1) : (active + delta + rows.length) % rows.length;
      rows.forEach((row, index) => {
        row.dataset.active = String(index === active);
      });
      const row = rows[active];
      search.setAttribute('aria-activedescendant', row.id);
      row.scrollIntoView({ block: 'nearest' });
    };
    trigger.addEventListener('click', open);
    search.addEventListener('input', () => render(search.value));
    search.addEventListener('keydown', event => {
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault();
        moveActive(event.key === 'ArrowDown' ? 1 : -1);
      } else if (event.key === 'Enter' && active >= 0) {
        event.preventDefault();
        const code = list.querySelectorAll<HTMLElement>('[role="option"]')[active]?.dataset.code;
        const option = options.find(item => item.code === code);
        if (option) choose(option);
      } else if (event.key === 'Escape') {
        event.preventDefault();
        close(true);
      }
    });
    root.querySelectorAll<HTMLButtonElement>('[data-currency-dismiss]').forEach(button => button.addEventListener('click', () => close(true)));
    document.addEventListener('pointerdown', event => {
      if (!layer.hidden && event.target instanceof Node && !root.contains(event.target)) close();
    });
    trigger.addEventListener('keydown', event => { if (event.key === 'ArrowDown' || event.key === 'Enter' || event.key === ' ') { event.preventDefault(); open(); } });
    document.addEventListener('economy:currency-options', event => {
      const detail = (event as CustomEvent<OptionsDetail>).detail;
      if (detail?.id !== id || !Array.isArray(detail.options)) return;
      options = detail.options;
      updateSelectedLabel();
      if (!layer.hidden) render(search.value);
    });
    document.addEventListener('economy:currency-value', event => {
      const detail = (event as CustomEvent<ValueDetail>).detail;
      if (detail?.id !== id) return;
      value = detail.value;
      trigger.disabled = Boolean(detail.disabled);
      updateSelectedLabel();
      if (!layer.hidden) render(search.value);
      if (trigger.disabled && !layer.hidden) close();
    });
  }
</script>
