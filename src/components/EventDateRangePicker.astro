---
import { formatDateRange, isValidDateOnly } from '../lib/date-range';
interface Props { startId:string; endId:string; id:string; label?:string; start?:string; end?:string }
const { startId,endId,id,label='Rentang tanggal',start='',end='' }=Astro.props;
const initialStart=isValidDateOnly(start)?start:'';
const initialEnd=isValidDateOnly(end)&&initialStart&&end>=initialStart?end:initialStart;
const formatted=initialStart?formatDateRange(initialStart,initialEnd):'Pilih tanggal';
---
<div class="range-picker" id={id} data-start-id={startId} data-end-id={endId} data-label={label}>
  <input type="hidden" id={startId} name={startId} value={initialStart} />
  <input type="hidden" id={endId} name={endId} value={initialEnd} />
  <button id={`${id}-trigger`} class="range-trigger" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls={`${id}-calendar`}><span class="range-label">{label}</span><span class="range-value">{formatted}</span></button>
  <button class="range-scrim" type="button" aria-label="Tutup kalender" tabindex="-1"></button>
  <section class="range-dialog" id={`${id}-calendar`} role="dialog" aria-label={label} hidden>
    <header class="calendar-header"><button type="button" class="previous" aria-label="Bulan sebelumnya">‹</button><strong class="month-title"></strong><button type="button" class="next" aria-label="Bulan berikutnya">›</button></header>
    <div class="calendar-grid" role="grid" aria-label="Kalender"></div>
    <p class="calendar-status" aria-live="polite">Pilih tanggal mulai.</p>
    <footer><button type="button" class="cancel">Batal</button><button type="button" class="confirm" disabled>Konfirmasi</button></footer>
  </section>
</div>
<style>
.range-picker { position:relative; color:var(--text-main); font:inherit; }
.range-trigger { display:flex; flex-direction:column; align-items:flex-start; justify-content:center; gap:2px; width:100%; min-height:48px; padding:8px 12px; color:var(--text-main); background:var(--bg-surface); border:1px solid var(--border-subtle); border-radius:var(--radius-sm); text-align:left; font:inherit; cursor:pointer; }
.range-label { color:var(--text-muted); font-size:.8rem; }.range-value{font-weight:600}
.range-trigger:focus-visible,.range-dialog :global(button:focus-visible) { outline:2px solid var(--border-active); outline-offset:2px; }
.range-dialog { position:absolute; z-index:40; top:calc(100% + 8px); left:0; width:min(22rem,calc(100vw - 24px)); padding:16px; color:var(--text-main); background:var(--bg-surface); border:1px solid var(--border-subtle); border-radius:var(--radius-lg); box-shadow:0 16px 40px #0002; }
.range-scrim { display:none; }
.calendar-header {display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:8px}.calendar-header strong{flex:1;text-align:center;text-transform:capitalize}.range-dialog :global(button){min-width:44px;min-height:44px;color:inherit;background:var(--bg-surface);border:1px solid var(--border-subtle);border-radius:var(--radius-sm);font:inherit;cursor:pointer}.calendar-grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:2px;max-height:min(55vh,20rem);overflow-y:auto;overscroll-behavior:contain}.calendar-grid :global(.weekday),.calendar-grid :global(.day){display:grid;place-items:center;min-height:44px}.calendar-grid :global(.weekday){color:var(--text-muted-readable);font-size:.75rem}.calendar-grid :global(.day){width:100%;min-width:0;padding:0;border:1px solid transparent;border-radius:var(--radius-sm);background:transparent;color:var(--text-main);font:inherit;cursor:pointer}.calendar-grid :global(.day:hover),.calendar-grid :global(.day[data-active=true]){background:var(--bg-surface-hover)}.calendar-grid :global(.day[data-in-range=true]){background:var(--primary-container);color:var(--on-primary-container)}.calendar-grid :global(.day[aria-selected=true]){background:var(--primary);color:var(--on-primary)}.calendar-grid :global(.day[data-range-start=true]){border-radius:var(--radius-sm) 4px 4px var(--radius-sm);font-weight:700;box-shadow:inset 0 0 0 1px var(--border-active)}.calendar-grid :global(.day[data-range-end=true]){border-radius:4px var(--radius-sm) var(--radius-sm) 4px;font-weight:700;box-shadow:inset 0 0 0 1px var(--border-active)}.calendar-grid :global(.day[data-range-start=true][data-range-end=true]){border-radius:var(--radius-full)}.calendar-grid :global(.day[data-today=true]){box-shadow:inset 0 0 0 2px var(--border-active)}.calendar-grid :global(.day:disabled){opacity:.4;cursor:not-allowed}.range-dialog footer{display:flex;justify-content:flex-end;gap:8px;margin-top:12px}.calendar-status{min-height:1.4em;color:var(--text-muted-readable);font-size:.85rem;margin:8px 0 0}.range-dialog [disabled]{opacity:.5;cursor:not-allowed}
@media(max-width:600px){.range-picker[data-open=true] .range-scrim{position:fixed;z-index:39;inset:0;display:block;width:100%;height:100%;border:0;border-radius:0;background:color-mix(in srgb,var(--text-main) 44%,transparent)}.range-dialog{position:fixed;z-index:40;inset:auto 0 0;width:auto;max-height:85dvh;overflow-y:auto;border-radius:var(--radius-lg) var(--radius-lg) 0 0;padding:20px 16px max(20px,env(safe-area-inset-bottom));}.calendar-grid{max-height:50dvh}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition:none!important;animation:none!important}}
</style>
<script>
import { formatDateRange as formatRange, normalizeDateRange as normalizeRange } from '../lib/date-range';
const pad=(n:number)=>String(n).padStart(2,'0');
const dateKey=(date:Date)=>`${date.getFullYear()}-${pad(date.getMonth()+1)}-${pad(date.getDate())}`;
const parse=(value:string)=>{const [y,m,d]=value.split('-').map(Number);return new Date(y,m-1,d,12);};
for(const root of document.querySelectorAll<HTMLElement>('.range-picker')){
 const trigger=root.querySelector<HTMLButtonElement>('.range-trigger')!,panel=root.querySelector<HTMLElement>('.range-dialog')!,grid=root.querySelector<HTMLElement>('.calendar-grid')!,title=root.querySelector<HTMLElement>('.month-title')!,status=root.querySelector<HTMLElement>('.calendar-status')!,confirm=root.querySelector<HTMLButtonElement>('.confirm')!;
 const startInput=document.getElementById(root.dataset.startId!) as HTMLInputElement,endInput=document.getElementById(root.dataset.endId!) as HTMLInputElement;
 let view=new Date(),first='',second='',choosingEnd=false,restore:HTMLElement|null=null;
 const close=(focus=false)=>{panel.hidden=true;root.dataset.open='false';trigger.setAttribute('aria-expanded','false');if(focus) (restore??trigger).focus();};
 const render=()=>{title.textContent=new Intl.DateTimeFormat('id-ID',{month:'long',year:'numeric'}).format(view);grid.replaceChildren();const weekdays=['Sen','Sel','Rab','Kam','Jum','Sab','Min'];weekdays.forEach(day=>{const cell=document.createElement('span');cell.className='weekday';cell.setAttribute('role','columnheader');cell.textContent=day;grid.append(cell);});const offset=(new Date(view.getFullYear(),view.getMonth(),1).getDay()+6)%7;for(let i=0;i<offset;i++){const blank=document.createElement('span');blank.setAttribute('role','gridcell');blank.setAttribute('aria-hidden','true');grid.append(blank);}const total=new Date(view.getFullYear(),view.getMonth()+1,0).getDate();for(let day=1;day<=total;day++){const date=new Date(view.getFullYear(),view.getMonth(),day,12),key=dateKey(date),button=document.createElement('button');button.type='button';button.className='day';button.setAttribute('role','gridcell');button.setAttribute('aria-label',new Intl.DateTimeFormat('id-ID',{dateStyle:'full'}).format(date));button.setAttribute('aria-selected',String(key===first||key===second));button.dataset.date=key;button.dataset.today=String(key===dateKey(new Date()));button.dataset.rangeStart=String(Boolean(first&&key===first));button.dataset.rangeEnd=String(Boolean(second&&key===second));button.dataset.inRange=String(Boolean(first&&second&&key>=first&&key<=second));button.textContent=String(day);button.addEventListener('click',()=>select(key));button.addEventListener('keydown',event=>{const delta=event.key==='ArrowRight'?1:event.key==='ArrowLeft'?-1:event.key==='ArrowDown'?7:event.key==='ArrowUp'?-7:0;if(delta){event.preventDefault();const next=new Date(date);next.setDate(next.getDate()+delta);view=new Date(next.getFullYear(),next.getMonth(),1);render();grid.querySelector<HTMLButtonElement>(`[aria-label="${new Intl.DateTimeFormat('id-ID',{dateStyle:'full'}).format(next)}"]`)?.focus();}else if(event.key==='Enter'||event.key===' '){event.preventDefault();select(key);}});grid.append(button);}};
 const select=(key:string)=>{if(!choosingEnd){first=key;second='';choosingEnd=true;status.textContent='Pilih tanggal selesai.';}else if(key<first){status.textContent='Tanggal selesai tidak boleh sebelum tanggal mulai.';return;}else{second=key;confirm.disabled=false;status.textContent=formatRange(first,second);}render();};
 trigger.addEventListener('click',()=>{restore=trigger;first=startInput.value;second=endInput.value;choosingEnd=false;confirm.disabled=!first||!second;view=first?new Date(parse(first).getFullYear(),parse(first).getMonth(),1):new Date();panel.hidden=false;root.dataset.open='true';trigger.setAttribute('aria-expanded','true');status.textContent=first&&second?`Rentang terpilih: ${formatRange(first,second)}. Pilih tanggal mulai untuk mengganti.`:first?'Pilih tanggal selesai.':'Pilih tanggal mulai.';render();grid.querySelector<HTMLButtonElement>('.day')?.focus();});
 root.querySelector<HTMLButtonElement>('.range-scrim')?.addEventListener('click',()=>close(true));
 document.addEventListener('pointerdown',event=>{if(!panel.hidden&&event.target instanceof Node&&!root.contains(event.target))close();});
 panel.addEventListener('keydown',event=>{if(event.key==='Escape'){event.preventDefault();close(true);}});
 panel.querySelector('.previous')!.addEventListener('click',()=>{view=new Date(view.getFullYear(),view.getMonth()-1,1);render();});panel.querySelector('.next')!.addEventListener('click',()=>{view=new Date(view.getFullYear(),view.getMonth()+1,1);render();});
 panel.querySelector('.cancel')!.addEventListener('click',()=>close(true));
 confirm.addEventListener('click',()=>{if(!first||!second||second<first)return;const result=normalizeRange(first,second);startInput.value=result.start;endInput.value=result.end;for(const input of [startInput,endInput]){input.dispatchEvent(new Event('input',{bubbles:true}));input.dispatchEvent(new Event('change',{bubbles:true}));}trigger.querySelector('.range-value')!.textContent=formatRange(result.start,result.end);document.dispatchEvent(new CustomEvent('economy:date-range-selected',{detail:result,bubbles:true}));close(true);});
}
</script>
