---
---
<template id="archive-event-card-template">
  <article class="archive-event-card">
    <div class="archive-event-identity">
      <div class="archive-event-title-row">
        <h3 class="event-name"></h3>
        <span class="badge event-status badge-completed">Selesai</span>
      </div>
      <p class="event-date muted"></p>
      <p class="event-participants-count archive-participants muted"></p>
    </div>
    <dl class="archive-event-stats">
      <div class="archive-event-budget"><dt>Total anggaran</dt><dd class="event-budget"></dd></div>
      <div><dt>Total pengeluaran</dt><dd class="event-expenses"></dd></div>
      <div><dt>Sisa</dt><dd class="event-remaining"></dd></div>
    </dl>
    <div class="archive-event-actions">
      <a href="#" class="btn btn-primary btn-sm action-open">Lihat laporan</a>
      <details class="archive-action-menu">
        <summary aria-label="Aksi arsip" title="Aksi arsip"><span aria-hidden="true">···</span></summary>
        <div class="archive-action-popover">
          <button type="button" class="btn btn-ghost btn-sm action-edit" hidden>Ubah</button>
          <button type="button" class="btn btn-danger btn-sm action-delete">Hapus event</button>
        </div>
      </details>
    </div>
  </article>
</template>
<style>
  .archive-event-card { display: grid; grid-template-columns: minmax(180px, .9fr) minmax(360px, 1.55fr) auto; align-items: center; gap: 28px; min-width: 0; padding: 22px 24px; border: 1px solid var(--border-subtle); border-radius: var(--radius-md); background: var(--bg-surface); transition: transform var(--motion-fast, 150ms) var(--ease-out-soft, ease), background-color var(--motion-control, 190ms) ease, box-shadow var(--motion-control, 190ms) ease; }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) { .archive-event-card:hover { transform: translateY(-1px); background: var(--bg-surface-variant); box-shadow: var(--shadow-sm); } }
  .archive-event-identity { display: grid; gap: 6px; min-width: 0; }
  .archive-event-title-row { display: flex; align-items: center; justify-content: flex-start; gap: 10px; min-width: 0; }
  .archive-event-title-row .event-name { min-width: 0; font: 500 18px/1.3 var(--font-heading); overflow-wrap: anywhere; }
  .archive-event-title-row .event-status { flex: 0 0 auto; }
  .archive-event-identity .event-date, .archive-participants { margin: 0; color: var(--text-muted-readable); font-size: 13px; }
  .archive-event-stats { display: grid; grid-template-columns: minmax(0, 1.2fr) repeat(2, minmax(0, 1fr)); gap: 18px; min-width: 0; margin: 0; padding: 4px 0; }
  .archive-event-stats > div { display: grid; align-content: center; gap: 5px; min-width: 0; }
  .archive-event-stats dt { color: var(--text-muted-readable); font-size: 12px; }
  .archive-event-stats dd { margin: 0; color: var(--text-main); font: 500 15px/1.35 var(--font-heading); font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
  .archive-event-stats .event-remaining.negative { color: var(--status-error-text); }
  .archive-event-actions { display: flex; align-items: center; justify-content: flex-end; gap: 8px; }
  .archive-action-menu { position: relative; }
  .archive-action-menu > summary { display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); background: var(--bg-surface); color: var(--text-main); cursor: pointer; list-style: none; font-size: 22px; line-height: 1; }
  .archive-action-menu > summary::-webkit-details-marker { display: none; }
  .archive-action-menu > summary:focus-visible { outline: 2px solid var(--border-active); outline-offset: 2px; }
  .archive-action-popover { position: absolute; z-index: 5; inset-block-start: calc(100% + 6px); inset-inline-end: 0; display: grid; min-width: 168px; padding: 6px; border: 1px solid var(--border-subtle); border-radius: var(--radius-md); background: var(--bg-surface); box-shadow: var(--shadow-md); }
  .archive-action-popover .btn { justify-content: flex-start; }
  @media (max-width: 900px) {
    .archive-event-card { grid-template-columns: minmax(0, 1fr) auto; gap: 18px; }
    .archive-event-stats { grid-column: 1 / -1; grid-row: 2; }
    .archive-event-actions { grid-column: 1 / -1; grid-row: 3; justify-content: flex-end; }
  }
  @media (max-width: 430px) {
    .archive-event-card { grid-template-columns: minmax(0, 1fr); gap: 16px; padding: 18px; }
    .archive-event-identity, .archive-event-stats, .archive-event-actions { grid-column: 1; grid-row: auto; }
    .archive-event-title-row { flex-direction: column; align-items: flex-start; }
    .archive-event-stats { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 14px 10px; }
    .archive-event-stats .archive-event-budget { grid-column: 1 / -1; }
    .archive-event-actions { justify-content: space-between; }
    .archive-event-actions .action-open { flex: 1; }
  }
</style>
