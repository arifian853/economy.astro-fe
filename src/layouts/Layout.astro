---
import "../styles/global.css";
import AppearanceControl from "../components/AppearanceControl.astro";
import { moodBootstrap } from "../lib/mood";

interface Props {
  title?: string;
  robots?: string;
}
const { title = "Economy", robots = "noindex, nofollow" } = Astro.props;
---

<!doctype html>
<html lang="id" data-mood="teal" style="color-scheme: light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={robots} />
    <meta name="referrer" content="no-referrer" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inclusive+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Lexend+Deca:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <meta name="theme-color" content="#F3F8F7" />
    <script is:inline set:html={moodBootstrap} />
    <title>{title}</title>
  </head>
  <body>
    <a href="#page-content" class="skip-link">Lewati ke konten</a>
    <header class="site-header"><div class="container site-header-inner">
      <a href="/" class="brand-link"><span class="brand-title">Economy<span class="brand-caption">Live Ledger</span></span></a>
      <div class="header-tools"><slot name="account" /><AppearanceControl id="header-appearance" /></div>
    </div></header>
    <div id="page-content" tabindex="-1"><slot /></div>
  </body>
</html>
