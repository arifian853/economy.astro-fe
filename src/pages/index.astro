---
import Layout from "../layouts/Layout.astro";
import GoogleLoginButton from "../components/GoogleLoginButton.astro";
import EventCard from "../components/EventCard.astro";
import EventForm from "../components/EventForm.astro";
---

<Layout title="Economy — Keuangan Event">
  <!-- Loading Session Awal -->
  <section id="session-loading" class="center-screen" aria-label="Memuat sesi">
    <div class="card card-sm center">
      <h1 class="state-brand">Economy</h1><p id="session-loading-text" class="muted" role="status">Memuat sesi…</p>
      <p id="session-error-box" class="error-box" role="alert" hidden></p>
      <button type="button" id="btn-force-login" class="btn btn-outline btn-sm" hidden>Lanjut ke halaman masuk</button>
    </div>
  </section>

  <!-- Halaman Login (Tampil jika belum login) -->
  <main id="login-view" class="center-screen login-screen" hidden>
    <div class="card login-panel">
      <section class="login-intro" aria-labelledby="login-title">
        <h1 id="login-title">Economy</h1>
        <p class="login-purpose">Keuangan event, dari anggaran hingga pembagian sisa dana.</p>
        <p class="muted login-description">Catat pengeluaran kegiatan dan hitung pembagian sisa dana secara rata untuk setiap peserta.</p>
        <dl class="login-tasks">
          <div><dt>Anggaran</dt><dd>Tentukan dana dan peserta event.</dd></div>
          <div><dt>Pengeluaran</dt><dd>Catat transaksi selama kegiatan.</dd></div>
          <div><dt>Pembagian sisa</dt><dd>Lihat bagian pengembalian tiap peserta.</dd></div>
        </dl>
      </section>
      <section class="login-access" aria-labelledby="login-access-title">
        <h2 id="login-access-title">Masuk ke Economy</h2>
        <p class="muted">Gunakan akun Google untuk membuka daftar event Anda.</p>
        <GoogleLoginButton />
        <p id="login-error" class="error-box" role="alert" hidden></p>
      </section>
    </div>
  </main>

  <!-- Halaman Utama Authenticated (My Events) -->
  <section id="app-view" class="app-layout" hidden>
    <!-- Topbar Navigation -->
    <header class="topbar">
      <div class="container topbar-inner">
        <a href="/" class="brand-link">
          <span class="brand-title">Economy</span>
        </a>
        <div class="user-menu">
          <span id="user-email" class="user-email muted"></span>
          <button type="button" id="btn-logout" class="btn btn-outline btn-sm">Keluar</button>
        </div>
      </div>
    </header>

    <!-- Main Content Area -->
    <main class="container main-content">
      <!-- Section Header -->
      <div class="section-header">
        <div>
          <h1>Event saya</h1>
          <p class="muted subtitle">Event berjalan dan arsip yang selesai tetap tersedia di sini</p>
        </div>
        <button type="button" id="btn-new-event" class="btn btn-primary">
          <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg> Buat event
        </button>
      </div>

      <!-- State: Loading Events -->
      <div id="events-loading" class="card center py-12" role="status">
        <p class="muted">Memuat daftar event…</p>
      </div>

      <!-- State: Error Loading Events -->
      <div id="events-error" class="error-container" hidden>
        <p id="events-error-msg" class="error-box" role="alert"></p>
        <button type="button" id="btn-retry" class="btn btn-outline btn-sm">Coba Lagi</button>
      </div>

      <!-- State: Empty Events (Checkpoint M7.2) -->
      <div id="events-empty" class="card center empty-card py-12" hidden>
        <div class="empty-icon-wrap">
          <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18M8 15h3"/></svg>
        </div>
        <h3>Belum ada event.</h3>
        <p class="muted">Buat event pertama Anda untuk mulai mencatat keuangan.</p>
        <button type="button" id="btn-create-first" class="btn btn-primary">
          <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg> Buat event
        </button>
      </div>

      <!-- State: Event List (Checkpoint M7.3) -->
      <div id="events-grid" class="events-grid" hidden></div>
    </main>
  </section>

  <!-- Template Event Card untuk Client-Side Rendering -->
  <EventCard />

  <!-- Form Modal Dialog untuk Tambah & Edit Event -->
  <EventForm />

  <script>
    import { supabase } from "../lib/supabase";
    import { fetchWithAuth } from "../lib/api";
    import { formatCurrency, formatDate } from "../lib/currency";
    import { getEventLifecycleView } from "../lib/event-lifecycle";
    import { alertDialog, confirmDialog } from "../lib/dialog";
    import type { EventItem } from "../types";

    const $ = <T extends HTMLElement = HTMLElement>(id: string): T | null =>
      document.getElementById(id) as T | null;

    // Toggle tampilan utama
    const showView = (view: "loading" | "login" | "app") => {
      const sLoad = $("session-loading");
      const sLogin = $("login-view");
      const sApp = $("app-view");
      if (sLoad) sLoad.hidden = view !== "loading";
      if (sLogin) sLogin.hidden = view !== "login";
      if (sApp) sApp.hidden = view !== "app";
    };

    // Toggle state di dalam daftar event
    const showEventState = (state: "loading" | "error" | "empty" | "grid") => {
      const eLoad = $("events-loading");
      const eErr = $("events-error");
      const eEmpty = $("events-empty");
      const eGrid = $("events-grid");
      if (eLoad) eLoad.hidden = state !== "loading";
      if (eErr) eErr.hidden = state !== "error";
      if (eEmpty) eEmpty.hidden = state !== "empty";
      if (eGrid) eGrid.hidden = state !== "grid";
    };

    // Global uncaught error display agar tidak ada silent crash
    window.addEventListener("error", (e) => {
      console.error("[Economy] Uncaught error:", e.error || e.message);
      const errBox = $("session-error-box");
      const btnForce = $("btn-force-login");
      if (errBox) {
        errBox.textContent = `Terjadi kendala: ${e.message || "Error script"}`;
        errBox.hidden = false;
      }
      if (btnForce) btnForce.hidden = false;
    });

    window.addEventListener("unhandledrejection", (e) => {
      console.error("[Economy] Unhandled rejection:", e.reason);
    });

    // Refresh events jika form berhasil disimpan
    window.addEventListener("refresh-events", () => {
      loadEvents();
    });

    // Event listener logout & login error
    $("login-view")?.addEventListener("login-error", (e) => {
      const box = $("login-error");
      if (box) {
        box.textContent = (e as CustomEvent<string>).detail;
        box.hidden = false;
      }
    });

    $("btn-logout")?.addEventListener("click", async () => {
      await supabase.auth.signOut();
      location.assign("/");
    });

    $("btn-force-login")?.addEventListener("click", () => {
      showView("login");
    });

    $("btn-retry")?.addEventListener("click", () => {
      loadEvents();
    });

    const triggerNewEvent = () => {
      window.dispatchEvent(new CustomEvent("open-event-form", { detail: { mode: "create" } }));
    };

    $("btn-new-event")?.addEventListener("click", triggerNewEvent);
    $("btn-create-first")?.addEventListener("click", triggerNewEvent);

    // Fungsi Fetch & Render Events
    async function loadEvents() {
      showEventState("loading");
      try {
        const res = await fetchWithAuth("/events");
        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          throw new Error(err.error || `Gagal mengambil event (status ${res.status})`);
        }
        const events: EventItem[] = await res.json();
        renderEvents(events);
      } catch (err: any) {
        const errMsgEl = $("events-error-msg");
        if (errMsgEl) {
          errMsgEl.textContent = err.message || "Terjadi kesalahan saat memuat event.";
        }
        showEventState("error");
      }
    }

    function renderEvents(events: EventItem[]) {
      const grid = $("events-grid");
      if (!grid) return;
      grid.innerHTML = "";

      if (!events || events.length === 0) {
        showEventState("empty");
        return;
      }

      const template = $("event-card-template") as HTMLTemplateElement | null;
      if (!template) {
        console.error("[Economy] Template event-card-template tidak ditemukan");
        return;
      }

      events.forEach((ev) => {
        const lifecycle = getEventLifecycleView(ev.status);
        const clone = template.content.cloneNode(true) as DocumentFragment;
        const article = clone.querySelector(".event-card");
        if (article && lifecycle.isArchived) article.classList.add("event-card-archived");

        const nameEl = clone.querySelector(".event-name");
        if (nameEl) nameEl.textContent = ev.name;

        const dateEl = clone.querySelector(".event-date");
        if (dateEl) dateEl.textContent = formatDate(ev.eventDate);

        const statusEl = clone.querySelector(".event-status");
        if (statusEl) {
          statusEl.textContent = { upcoming: "Akan datang", active: "Berlangsung", completed: "Selesai" }[ev.status];
          statusEl.className = `badge badge-${ev.status}`;
        }

        const budgetEl = clone.querySelector(".event-budget");
        if (budgetEl) budgetEl.textContent = formatCurrency(ev.budget);

        const expensesEl = clone.querySelector(".event-expenses");
        if (expensesEl) expensesEl.textContent = formatCurrency(ev.totalExpenses || 0);

        const remaining = ev.budget - (ev.totalExpenses || 0);
        const remainingEl = clone.querySelector(".event-remaining");
        if (remainingEl) {
          if (remaining < 0) {
            remainingEl.textContent = `−${formatCurrency(Math.abs(remaining))}`;
            remainingEl.classList.add("negative");
          } else {
            remainingEl.textContent = formatCurrency(remaining);
          }
        }

        const countEl = clone.querySelector(".event-participants-count");
        if (countEl) countEl.textContent = `${ev.participantCount || 0} peserta`;

        // Actions
        const openBtn = clone.querySelector(".action-open") as HTMLAnchorElement | null;
        if (openBtn) {
          openBtn.href = `/event/${ev.id}`;
          openBtn.textContent = lifecycle.isArchived ? "Lihat laporan" : "Buka event";
          openBtn.setAttribute("aria-label", `${lifecycle.isArchived ? "Lihat laporan" : "Buka event"} ${ev.name}`);
        }

        const editBtn = clone.querySelector(".action-edit") as HTMLButtonElement | null;
        if (editBtn) {
          editBtn.hidden = !lifecycle.canEditEvent;
          if (lifecycle.canEditEvent) {
            editBtn.setAttribute("aria-label", `Ubah event ${ev.name}`);
            editBtn.addEventListener("click", () => {
              window.dispatchEvent(new CustomEvent("open-event-form", { detail: { mode: "edit", event: ev } }));
            });
          }
        }

        const deleteBtn = clone.querySelector(".action-delete") as HTMLButtonElement | null;
        if (deleteBtn) {
          deleteBtn.hidden = !lifecycle.canDeleteEvent;
          if (lifecycle.canDeleteEvent) {
            deleteBtn.setAttribute("aria-label", `Hapus event ${ev.name}`);
            deleteBtn.addEventListener("click", async () => {
              const confirmed = await confirmDialog({
                title: `Hapus event "${ev.name}"?`,
                message: "Event ini dan semua data di dalamnya akan dihapus permanen.",
                confirmLabel: "Hapus event",
                cancelLabel: "Batal",
                destructive: true,
              });
              if (!confirmed) {
                return;
              }
              deleteBtn.disabled = true;
              try {
                const res = await fetchWithAuth(`/events/${ev.id}`, { method: "DELETE" });
                if (!res.ok) {
                  const err = await res.json().catch(() => ({}));
                  throw new Error(err.error || "Gagal menghapus event.");
                }
                await loadEvents();
              } catch (err: any) {
                await alertDialog({ message: err.message || "Gagal menghapus event." });
                deleteBtn.disabled = false;
              }
            });
          }
        }

        grid.appendChild(clone);
      });

      showEventState("grid");
    }

    // Lifecycle & Session state
    let sessionResolved = false;

    const handleSession = (email: string | null | undefined, loggedIn: boolean) => {
      sessionResolved = true;
      if (sessionTimeout) clearTimeout(sessionTimeout);

      if (loggedIn) {
        const emailEl = $("user-email");
        if (emailEl) emailEl.textContent = email ?? "";
        showView("app");
        loadEvents();
      } else {
        showView("login");
      }
    };

    // Safeguard timeout 1.5 detik: jangan biarkan UI stuck di loading jika Supabase slow/hang
    const sessionTimeout = setTimeout(() => {
      if (!sessionResolved) {
        console.warn("[Economy] Session check timed out, displaying login view");
        handleSession(null, false);
      }
    }, 1500);

    // Inisialisasi session dengan try/catch aman
    try {
      const { data, error } = await supabase.auth.getSession();
      if (error) {
        console.error("[Economy] getSession error:", error);
        handleSession(null, false);
      } else {
        handleSession(data.session?.user.email, !!data.session);
      }
    } catch (err) {
      console.error("[Economy] Session init exception:", err);
      handleSession(null, false);
    }

    supabase.auth.onAuthStateChange((_event, session) => {
      handleSession(session?.user.email, !!session);
    });
  </script>
</Layout>

<style>
  .center-screen { min-height: 100svh; display: grid; place-items: center; padding: 24px; }
  .card-sm { width: 100%; max-width: 440px; }
  .login-panel { width: 100%; max-width: 960px; display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); padding: 0; overflow: hidden; }
  .login-intro { padding: 48px; background: var(--bg-surface-variant); }
  .login-intro h1 { font-size: 28px; color: var(--primary); letter-spacing: -0.3px; }
  .login-purpose { font-family: var(--font-heading); font-size: 20px; line-height: 1.5; margin: 24px 0 12px; text-wrap: balance; }
  .login-description { margin: 0; }
  .login-tasks { margin: 32px 0 0; display: grid; gap: 16px; }
  .login-tasks div { display: grid; gap: 2px; }
  .login-tasks dt { font-weight: 600; }
  .login-tasks dd { margin: 0; color: var(--text-muted); font-size: 13px; }
  .login-access { padding: 40px; display: flex; flex-direction: column; justify-content: center; align-items: stretch; gap: 16px; }
  .login-access h2 { font-size: 18px; }
  .login-access p { margin: 0; }
  .login-access :global(.google-button) { margin-top: 8px; }
  .events-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .error-container { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
  @media (max-width: 700px) {
    .center-screen { padding: 20px 16px; }
    .login-panel { max-width: 480px; grid-template-columns: minmax(0, 1fr); }
    .login-intro, .login-access { padding: 28px 24px; }
    .login-purpose { margin-top: 20px; }
    .login-tasks { margin-top: 24px; gap: 12px; }
    .events-grid { grid-template-columns: minmax(0, 1fr); gap: 16px; }
  }
</style>
