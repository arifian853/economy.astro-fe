---
import Layout from "../layouts/Layout.astro";
import EconomyAccessPanel from "../components/EconomyAccessPanel.astro";
import EventCard from "../components/EventCard.astro";
import ArchiveEventCard from "../components/ArchiveEventCard.astro";
import EventForm from "../components/EventForm.astro";
---

<Layout title="Economy — Keuangan Event">
  <!-- Loading Session Awal -->
  <section id="session-loading" class="center-screen" aria-label="Memuat sesi">
    <div class="card card-sm center">
      <h1 class="state-brand">Economy</h1><p id="session-loading-text" class="muted" role="status">Memuat sesi…</p>
      <p id="session-error-box" class="error-box" role="alert" hidden></p>
      <button type="button" id="btn-force-login" class="btn btn-outline btn-sm" hidden>Lanjut ke halaman masuk</button>
    </div>
  </section>

  <!-- Halaman Login (Tampil jika belum login) -->
  <main id="login-view" class="login-screen" hidden>
    <div class="login-panel">
      <section class="login-intro" aria-labelledby="login-title">
        <p class="eyebrow">Economy — Live Ledger</p>
        <h1 id="login-title">Spend together.<br /><span>See the numbers clearly.</span></h1>
        <p class="login-description">Catat pengeluaran event dan bagikan kondisinya secara live.</p>
        <div class="gate-ledger" aria-label="Contoh ilustrasi keuangan event">
          <div class="gate-ledger-head"><span>Weekend bersama</span><span class="badge badge-active">Contoh ilustrasi</span></div>
          <p class="eyebrow">Sisa anggaran</p><strong class="gate-remaining">Rp1.275.000</strong>
          <progress max="2000000" value="725000" aria-label="Contoh anggaran terpakai"></progress>
          <dl class="gate-totals"><div><dt>Anggaran</dt><dd>Rp2.000.000</dd></div><div><dt>Terpakai</dt><dd>Rp725.000</dd></div></dl>
          <div class="gate-entry"><div><strong>Makan siang bersama</strong><span>4 × Rp35.000 · QRIS</span></div><strong>Rp140.000</strong></div>
          <p class="gate-footnote">Angka ilustrasi · bukan data pengguna</p>
        </div>
      </section>
      <EconomyAccessPanel />
    </div>
  </main>

    <div slot="account" id="account-controls" class="user-menu" hidden><span id="user-email" class="user-email muted"></span><button type="button" id="btn-logout" class="btn btn-outline btn-sm">Keluar</button></div>

  <!-- Halaman Utama Authenticated (My Events) -->
  <section id="app-view" class="app-layout" hidden>
    <!-- Main Content Area -->
    <main id="main-content" class="container main-content">
      <!-- Section Header -->
      <div class="section-header">
        <div>
          <h1>Event saya</h1>
          <p class="muted subtitle">Event berjalan dan arsip yang selesai tetap tersedia di sini</p>
        </div>
        <button type="button" id="btn-new-event" class="btn btn-primary">
          <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg> Buat event
        </button>
      </div>

      <!-- State: Loading Events -->
      <div id="events-loading" class="card center py-12" role="status">
        <p class="muted">Memuat daftar event…</p>
      </div>

      <!-- State: Error Loading Events -->
      <div id="events-error" class="error-container" hidden>
        <p id="events-error-msg" class="error-box" role="alert"></p>
        <button type="button" id="btn-retry" class="btn btn-outline btn-sm">Coba Lagi</button>
      </div>

      <!-- State: Empty Events (Checkpoint M7.2) -->
      <div id="events-empty" class="card center empty-card py-12" hidden>
        <div class="empty-icon-wrap">
          <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18M8 15h3"/></svg>
        </div>
        <h3>Belum ada event.</h3>
        <p class="muted">Buat event pertama Anda untuk mulai mencatat keuangan.</p>
        <button type="button" id="btn-create-first" class="btn btn-primary">
          <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg> Buat event
        </button>
      </div>

      <!-- State: Event List (Checkpoint M7.3) -->
      <div id="events-grid" class="events-grid" hidden></div>
    </main>
  </section>

  <!-- Template Event Card untuk Client-Side Rendering -->
  <EventCard />
  <ArchiveEventCard />

  <!-- Form Modal Dialog untuk Tambah & Edit Event -->
  <EventForm />

  <script>
    import { supabase } from "../lib/supabase";
    import { fetchWithAuth } from "../lib/api";
    import { formatCurrency } from "../lib/currency";
    import { formatDateRange } from "../lib/date-range";
    import { subtractMoney, absMoney, compareMoney } from "../lib/money";
    import { approximateIdr, eventReference, referenceLabel } from "../lib/fx";
    import { getEventLifecycleView } from "../lib/event-lifecycle";
    import { alertDialog, confirmDialog } from "../lib/dialog";
    import type { EventItem } from "../types";

    const $ = <T extends HTMLElement = HTMLElement>(id: string): T | null =>
      document.getElementById(id) as T | null;

    // Toggle tampilan utama
    const showView = (view: "loading" | "login" | "app") => {
      const sLoad = $("session-loading");
      const sLogin = $("login-view");
      const sApp = $("app-view");
      if (sLoad) sLoad.hidden = view !== "loading";
      if (sLogin) sLogin.hidden = view !== "login";
      if (sApp) sApp.hidden = view !== "app";
      const account = $("account-controls");
      if (account) account.hidden = view !== "app";
    };

    // Toggle state di dalam daftar event
    const showEventState = (state: "loading" | "error" | "empty" | "grid") => {
      const eLoad = $("events-loading");
      const eErr = $("events-error");
      const eEmpty = $("events-empty");
      const eGrid = $("events-grid");
      if (eLoad) eLoad.hidden = state !== "loading";
      if (eErr) eErr.hidden = state !== "error";
      if (eEmpty) eEmpty.hidden = state !== "empty";
      if (eGrid) eGrid.hidden = state !== "grid";
    };

    // Global uncaught error display agar tidak ada silent crash
    window.addEventListener("error", (e) => {
      console.error("[Economy] Uncaught error:", e.error || e.message);
      const errBox = $("session-error-box");
      const btnForce = $("btn-force-login");
      if (errBox) {
        errBox.textContent = `Terjadi kendala: ${e.message || "Error script"}`;
        errBox.hidden = false;
      }
      if (btnForce) btnForce.hidden = false;
    });

    window.addEventListener("unhandledrejection", (e) => {
      console.error("[Economy] Unhandled rejection:", e.reason);
    });

    // Refresh events jika form berhasil disimpan
    window.addEventListener("refresh-events", () => {
      loadEvents();
    });

    // Event listener logout & login error
    $("login-view")?.addEventListener("login-error", (e) => {
      const box = $("login-error");
      if (box) {
        box.textContent = (e as CustomEvent<string>).detail;
        box.hidden = false;
      }
    });

    $("btn-logout")?.addEventListener("click", async () => {
      await supabase.auth.signOut();
      location.assign("/");
    });

    $("btn-force-login")?.addEventListener("click", () => {
      showView("login");
    });

    $("btn-retry")?.addEventListener("click", () => {
      loadEvents();
    });

    const triggerNewEvent = () => {
      window.dispatchEvent(new CustomEvent("open-event-form", { detail: { mode: "create" } }));
    };

    $("btn-new-event")?.addEventListener("click", triggerNewEvent);
    $("btn-create-first")?.addEventListener("click", triggerNewEvent);

    // Fungsi Fetch & Render Events
    async function loadEvents() {
      showEventState("loading");
      try {
        const res = await fetchWithAuth("/events");
        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          throw new Error(err.error || `Gagal mengambil event (status ${res.status})`);
        }
        const events: EventItem[] = await res.json();
        renderEvents(events);
      } catch (err: any) {
        const errMsgEl = $("events-error-msg");
        if (errMsgEl) {
          errMsgEl.textContent = err.message || "Terjadi kesalahan saat memuat event.";
        }
        showEventState("error");
      }
    }

    let hasRenderedHomeEvents = false;
    function renderEvents(events: EventItem[]) {
      const grid = $("events-grid");
      if (!grid) return;
      grid.innerHTML = "";

      if (!events || events.length === 0) {
        showEventState("empty");
        return;
      }

      const template = $("event-card-template") as HTMLTemplateElement | null;
      const archiveTemplate = $("archive-event-card-template") as HTMLTemplateElement | null;
      if (!template || !archiveTemplate) {
        console.error("[Economy] Template kartu event tidak ditemukan");
        return;
      }

      const lifecycleGroups = new Map<string, HTMLElement>();
      for (const status of ["active", "upcoming", "completed"]) {
        const matching = events.filter(event => event.status === status);
        if (!matching.length) continue;
        const section = document.createElement('section');
        section.className = `lifecycle-group lifecycle-${status}`;
        const heading = document.createElement('h2');
        heading.textContent = { active: 'Sedang berlangsung', upcoming: 'Akan datang', completed: 'Arsip selesai' }[status]!;
        const list = document.createElement('div');
        list.className = 'lifecycle-list';
        section.append(heading, list);
        grid.append(section);
        lifecycleGroups.set(status, list);
      }
      events.forEach((ev) => {
        const currency = ev.baseCurrency ?? 'IDR';
        const money = (amount: import('../lib/money').Money) => formatCurrency(amount, currency);
        const lifecycle = getEventLifecycleView(ev.status);
        const selectedTemplate = lifecycle.isArchived ? archiveTemplate : template;
        const clone = selectedTemplate.content.cloneNode(true) as DocumentFragment;

        const nameEl = clone.querySelector(".event-name");
        if (nameEl) nameEl.textContent = ev.name;

        const dateEl = clone.querySelector(".event-date");
        if (dateEl) dateEl.textContent = formatDateRange(ev.eventDate, ev.eventEndDate ?? ev.eventDate);

        const statusEl = clone.querySelector(".event-status");
        if (statusEl) {
          statusEl.textContent = { upcoming: "Akan datang", active: "Berlangsung", completed: "Selesai" }[ev.status];
          statusEl.className = `badge badge-${ev.status}`;
        }

        const budgetEl = clone.querySelector(".event-budget");
        if (budgetEl) budgetEl.textContent = money(ev.budget);

        const expensesEl = clone.querySelector(".event-expenses");
        if (expensesEl) expensesEl.textContent = money(ev.totalExpenses || 0);

        const remaining = subtractMoney(ev.budget, ev.totalExpenses || 0, currency);
        const remainingEl = clone.querySelector(".event-remaining");
        if (remainingEl) {
          if (compareMoney(remaining, '0', currency) < 0) {
            remainingEl.textContent = `−${money(absMoney(remaining, currency))}`;
            remainingEl.classList.add("negative");
          } else {
            remainingEl.textContent = money(remaining);
          }
        }

        if (currency !== 'IDR') {
          for (const [selector, value] of [['.event-budget', ev.budget], ['.event-expenses', ev.totalExpenses || '0'], ['.event-remaining', absMoney(remaining, currency)]] as const) {
            const secondary = document.createElement('small'); secondary.className = 'fx-equivalent';
            secondary.textContent = approximateIdr(value, currency, eventReference(ev));
            secondary.title = referenceLabel(eventReference(ev), lifecycle.isArchived);
            clone.querySelector(selector)?.append(secondary);
          }
        }
        const countEl = clone.querySelector(".event-participants-count");
        if (countEl) countEl.textContent = `${ev.participantCount || 0} peserta`;

        // Actions
        const openBtn = clone.querySelector(".action-open") as HTMLAnchorElement | null;
        if (openBtn) {
          openBtn.href = `/event/${ev.id}`;
          openBtn.textContent = lifecycle.isArchived ? "Lihat laporan" : "Buka event";
          openBtn.setAttribute("aria-label", `${lifecycle.isArchived ? "Lihat laporan" : "Buka event"} ${ev.name}`);
        }

        const editBtn = clone.querySelector(".action-edit") as HTMLButtonElement | null;
        if (editBtn) {
          editBtn.hidden = !lifecycle.canEditEvent;
          if (lifecycle.canEditEvent) {
            editBtn.setAttribute("aria-label", `Ubah event ${ev.name}`);
            editBtn.addEventListener("click", () => {
              window.dispatchEvent(new CustomEvent("open-event-form", { detail: { mode: "edit", event: ev } }));
            });
          }
        }

        const deleteBtn = clone.querySelector(".action-delete") as HTMLButtonElement | null;
        if (deleteBtn) {
          deleteBtn.hidden = !lifecycle.canDeleteEvent;
          if (lifecycle.canDeleteEvent) {
            deleteBtn.setAttribute("aria-label", `Hapus event ${ev.name}`);
            deleteBtn.addEventListener("click", async () => {
              const confirmed = await confirmDialog({
                title: `Hapus event "${ev.name}"?`,
                message: "Event ini dan semua data di dalamnya akan dihapus permanen.",
                confirmLabel: "Hapus event",
                cancelLabel: "Batal",
                destructive: true,
              });
              if (!confirmed) {
                return;
              }
              deleteBtn.disabled = true;
              try {
                const res = await fetchWithAuth(`/events/${ev.id}`, { method: "DELETE" });
                if (!res.ok) {
                  const err = await res.json().catch(() => ({}));
                  throw new Error(err.error || "Gagal menghapus event.");
                }
                await loadEvents();
              } catch (err: any) {
                await alertDialog({ message: err.message || "Gagal menghapus event." });
                deleteBtn.disabled = false;
              }
            });
          }
        }

        lifecycleGroups.get(ev.status)?.appendChild(clone);
      });

      grid.classList.toggle("home-events-entered", !hasRenderedHomeEvents);
      hasRenderedHomeEvents = true;
      showEventState("grid");
    }

    // Lifecycle & Session state
    let sessionResolved = false;

    const handleSession = (email: string | null | undefined, loggedIn: boolean) => {
      sessionResolved = true;
      if (sessionTimeout) clearTimeout(sessionTimeout);

      if (loggedIn) {
        const emailEl = $("user-email");
        if (emailEl) emailEl.textContent = email ?? "";
        showView("app");
        loadEvents();
      } else {
        showView("login");
      }
    };

    // Safeguard timeout 1.5 detik: jangan biarkan UI stuck di loading jika Supabase slow/hang
    const sessionTimeout = setTimeout(() => {
      if (!sessionResolved) {
        console.warn("[Economy] Session check timed out, displaying login view");
        handleSession(null, false);
      }
    }, 1500);

    // Inisialisasi session dengan try/catch aman
    try {
      const { data, error } = await supabase.auth.getSession();
      if (error) {
        console.error("[Economy] getSession error:", error);
        handleSession(null, false);
      } else {
        handleSession(data.session?.user.email, !!data.session);
      }
    } catch (err) {
      console.error("[Economy] Session init exception:", err);
      handleSession(null, false);
    }

    supabase.auth.onAuthStateChange((_event, session) => {
      handleSession(session?.user.email, !!session);
    });
  </script>
</Layout>

<style>
  .center-screen { min-height: 70svh; display: grid; place-items: center; padding: 24px; }
  .card-sm { width: 100%; max-width: 440px; }
  .login-screen { padding: 32px 16px 64px; }
    .login-panel { width: min(100%, 1200px); margin: auto; display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 64px; align-items: center; }
  @media (prefers-reduced-motion: no-preference) {
    #login-view:not([hidden]) .login-intro > * { animation: login-reveal var(--motion-layout) var(--ease-out-soft) both; }
    #login-view:not([hidden]) .login-intro > :nth-child(2) { animation-delay: 40ms; }
    #login-view:not([hidden]) .login-intro > :nth-child(3) { animation-delay: 80ms; }
    #login-view:not([hidden]) .login-intro > :nth-child(4) { animation-delay: 120ms; }
    #login-view:not([hidden]) .economy-access-panel { animation: login-reveal var(--motion-layout) var(--ease-out-soft) 120ms both; }
  }
  @keyframes login-reveal { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
  .login-intro { padding: 32px; }
  .login-intro h1 { font-size: clamp(32px, 4.2vw, 56px); line-height: 1.18; letter-spacing: -.04em; margin: 24px 0; font-weight: 500; }
  .login-intro h1 span { color: var(--primary); }
  .login-description { font-size: 18px; max-width: 36ch; color: var(--text-muted-readable); }
  .gate-ledger { margin-top: 40px; padding: 24px; background: var(--primary-container); color: var(--on-primary-container); border-radius: var(--radius-lg); }
  .gate-ledger-head { display: flex; flex-wrap: wrap; gap: 12px; justify-content: space-between; padding-bottom: 28px; }
  .gate-remaining { display: block; font: 500 clamp(28px, 3vw, 40px) var(--font-heading); letter-spacing: -.04em; overflow-wrap: anywhere; }
  .gate-totals { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; margin: 16px 0 24px; }
  .gate-totals dt { font-size: 12px; }
  .gate-totals dd { margin: 4px 0 0; font-weight: 600; }
  .gate-entry { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; padding-top: 20px; border-top: 1px solid color-mix(in srgb, var(--primary) 25%, transparent); }
  .gate-entry div { display: flex; flex-direction: column; gap: 4px; }
  .gate-entry span, .gate-footnote { font-size: 12px; }
  .gate-footnote { margin: 20px 0 0; }
  .events-grid { display: flex; flex-direction: column; gap: 48px; }
  .error-container { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
  @media (max-width: 760px) {
    .login-screen { padding-top: 8px; }
    .login-panel { grid-template-columns: minmax(0, 1fr); gap: 24px; max-width: 520px; }
    .login-intro { padding: 16px 0 0; }
    .login-intro h1 { font-size: clamp(30px, 8vw, 44px); }
    .login-description { font-size: 16px; }
    .gate-ledger { margin-top: 24px; padding: 20px; }
  }
</style>
